generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======================================================
// 1. Core Architecture (Panel A Roles & Multi-tenant)
// ======================================================

model CareHome {
  id          String   @id @default(uuid())
  name        String
  branchCode  String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  roles       Role[]
  residents   Resident[]
  shifts      Shift[]
  enquiries   Enquiry[]
  maintenanceTickets MaintenanceTicket[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  careHomeId  String
  careHome    CareHome @relation(fields: [careHomeId], references: [id])
  
  // Granular Permission Flags for Panel A
  canViewEmar           Boolean @default(false)
  canEditRota           Boolean @default(false)
  canViewFinance        Boolean @default(false)
  canManageKitchen      Boolean @default(false)
  
  // New comprehensive permissions
  canManageStaff        Boolean @default(false)
  canViewResidents      Boolean @default(true)
  canManageCRM          Boolean @default(false)
  canManageMessages     Boolean @default(true)
  canManageMaintenance  Boolean @default(false)
  canManageVisitors     Boolean @default(false)
  canManageSafeguarding Boolean @default(false)
  canManageReports      Boolean @default(false)

  // Newly added to cover all 16 menus
  canViewDashboard      Boolean @default(true)
  canManageRoles        Boolean @default(false)
  canManageProfile      Boolean @default(true)
  canManageSettings     Boolean @default(false)

  isSuperAdmin          Boolean @default(false)

  users       User[]
  
  @@unique([name, careHomeId])
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  phone       String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careHomeId  String
  careHome    CareHome @relation(fields: [careHomeId], references: [id])
  
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id])
  
  // Core application access
  userType    UserType @default(WORKER)

  // Relations
  shifts          Shift[]
  complianceDocs  ComplianceDocument[]
  givenMeds       EmarLog[]
  handovers       Handover[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

enum UserType {
  SUPER_ADMIN // Panel A Access
  ADMIN       // Panel A Access
  WORKER      // Panel B Access
  CLIENT      // Panel C Access
}

// ======================================================
// 2. Resident & Medical Schema (Care & eMAR)
// ======================================================

model Resident {
  id                    String   @id @default(uuid())
  firstName             String
  lastName              String
  nhsNumber             String?
  dateOfBirth           DateTime
  roomNumber            String?
  dietaryReqs           String?    @db.Text
  allergies             String?    @db.Text
  dietaryNeeds          String?
  medicalHistory        String?    @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  photo                 String?
  
  careHomeId      String
  careHome        CareHome @relation(fields: [careHomeId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  medications     Medication[]
  emarLogs        EmarLog[]
  progressNotes   ProgressNote[]
  familyMembers   FamilyLink[]
  invoices        Invoice[]
}

model Medication {
  id          String   @id @default(uuid())
  name        String
  dosage      String
  frequency   String   // e.g., "Morning", "Evening", "As needed"
  instructions String?
  
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  
  logs        EmarLog[]
}

model EmarLog {
  id            String   @id @default(uuid())
  status        EmarStatus // Administered or Refused
  refusalReason String?    // Mandatory if Refused
  timestamp     DateTime @default(now())
  
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id])
  
  residentId    String
  resident    Resident   @relation(fields: [residentId], references: [id])
  
  administeredById String
  administeredBy   User     @relation(fields: [administeredById], references: [id])
}

enum EmarStatus {
  ADMINISTERED
  REFUSED
  MISSED
}

model ProgressNote {
  id          String   @id @default(uuid())
  note        String   @db.Text
  mood        String?
  foodIntake  String?
  timestamp   DateTime @default(now())
  
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
}

// ======================================================
// 3. Workforce & Rota Schema
// ======================================================

model Shift {
  id          String   @id @default(uuid())
  title       String
  startTime   DateTime
  endTime     DateTime
  isOpen      Boolean  @default(false) // Broadcasted open shift
  status      ShiftStatus @default(SCHEDULED)
  notes       String?  @db.Text
  
  careHomeId  String
  careHome    CareHome @relation(fields: [careHomeId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  ABSENT
}

model ComplianceDocument {
  id          String   @id @default(uuid())
  type        DocType
  documentUrl String
  expiryDate  DateTime
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

enum DocType {
  PASSPORT
  VISA
  DBS
  TRAINING_CERT
}

model Handover {
  id          String   @id @default(uuid())
  notes       String   @db.Text
  timestamp   DateTime @default(now())
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

// ======================================================
// 4. Family / Client Schema
// ======================================================

model FamilyLink {
  id          String   @id @default(uuid())
  relation    String   // e.g., "Son", "Daughter"
  canViewLogs Boolean  @default(false)
  
  familyMemberId String
  // The family member will be an entry in the User table with UserType=CLIENT
  
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
}

model Enquiry {
  id                    String   @id @default(uuid())
  careHomeId            String
  careHome              CareHome @relation(fields: [careHomeId], references: [id])
  
  firstName             String   @default("")
  lastName              String   @default("")
  contactName           String?
  contactPhone          String?
  contactEmail          String?
  careRequired          String?
  visitDate             DateTime?
  
  status                String   @default("New") // New, In Progress, Visit, Admitted, Lost
  notes                 String?  @db.Text
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MaintenanceTicket {
  id          String   @id @default(uuid())
  careHomeId  String
  careHome    CareHome @relation(fields: [careHomeId], references: [id])
  title       String
  description String   @db.Text
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  reportedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitorLog {
  id          String   @id @default(uuid())
  careHomeId  String
  name        String
  purpose     String
  signInTime  DateTime @default(now())
  signOutTime DateTime?
}

model IncidentReport {
  id          String   @id @default(uuid())
  careHomeId  String
  title       String
  description String   @db.Text
  severity    String
  status      String   @default("OPEN")
  reportedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(uuid())
  careHomeId  String
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  amount      Float
  description String
  status      String   @default("UNPAID") // UNPAID, PAID, OVERDUE
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ======================================================
// 5. Messaging & Communication
// ======================================================

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  timestamp   DateTime @default(now())
  isRead      Boolean  @default(false)
  
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}
